{
  "type": "object",
  "additionalProperties": false,
  "required": ["headline", "sessions", "tasks", "key_dates", "gaps"],
  "properties": {
    "headline": {"type": "string"},
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["course", "title", "kind", "start", "time_known", "mode", "confidence", "source_url"],
        "properties": {
          "course": {"type": "string"},
          "title": {"type": "string"},
          "kind": {"enum": ["lecture", "tutorial", "seminar", "consultation", "test", "exam", "presentation", "other"]},
          "start": {"type": "string", "description": "ISO 8601 with +08:00"},
          "end": {"type": ["string", "null"]},
          "time_known": {"type": "boolean"},
          "mode": {"enum": ["online", "in_person", "hybrid", "unknown"]},
          "venue": {"type": ["string", "null"]},
          "platform": {"enum": ["zoom", "teams", "other", null]},
          "join_url": {"type": ["string", "null"]},
          "meeting_id": {"type": ["string", "null"]},
          "passcode": {"type": ["string", "null"]},
          "instructor": {"type": ["string", "null"]},
          "prep": {"type": ["string", "null"]},
          "notes": {"type": ["string", "null"]},
          "confidence": {"enum": ["high", "medium", "low"]},
          "source_url": {"type": ["string", "null"]}
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["course", "title", "priority"],
        "properties": {
          "course": {"type": "string"},
          "title": {"type": "string"},
          "due": {"type": ["string", "null"], "description": "ISO 8601 with +08:00, or null"},
          "details": {"type": ["string", "null"]},
          "priority": {"enum": ["high", "medium", "low"]},
          "url": {"type": ["string", "null"]}
        }
      }
    },
    "key_dates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["course", "title", "date"],
        "properties": {
          "course": {"type": "string"},
          "title": {"type": "string"},
          "date": {"type": "string"},
          "details": {"type": ["string", "null"]},
          "url": {"type": ["string", "null"]}
        }
      }
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["course", "issue"],
        "properties": {"course": {"type": "string"}, "issue": {"type": "string"}}
      }
    }
  }
}
